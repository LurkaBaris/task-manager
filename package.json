    "@hookform/resolvers": "^5.4.0",
    "@mantine/carousel": "^9.4.1",
    "@mantine/core": "^9.4.1",
    "@mantine/hooks": "^9.4.1",
    "@mantine/notifications": "^9.4.1",
    "chart.js": "^4.5.1",
    "clsx": "^2.1.1",
    "embla-carousel": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "idb": "^8.0.3",
    "lucide-react": "^1.22.0",
    "react": "^19.2.7",
